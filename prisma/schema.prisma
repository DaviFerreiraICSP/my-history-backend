generator client {
  provider = "prisma-client-js"
}

// Para usar Postgres (ex: Neon/Supabase), alteramos de sqlite para postgresql.
// O banco URL ficará na variável DATABASE_URL no .env
datasource db {
  provider = "postgresql"
}

model LocationStory {
  id        String   @id @default(uuid())
  name      String   @unique
  latitude  Float
  longitude Float
  story     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
